          },
          "snapshot_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Snapshot Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_field",
          "question",
          "source_ids",
          "mode",
          "project_id",
          "snapshot_version"
        ],
        "title": "QuestionResponse"
      },
      "SearchHit": {
        "properties": {
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Source"
              },
              {
                "$ref": "#/components/schemas/LegalEdition"
              }
            ],
            "title": "Source"
          },
          "similarity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Similarity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "similarity"
        ],
        "title": "SearchHit"
      },
      "SearchRequest": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ProjectContext"
          },
          "query": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query"
          },
          "scope": {
            "type": "string",
            "enum": [
              "project",
              "legal"
            ],
            "title": "Scope",
            "default": "project"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "context",
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Project Id"
          },
          "scope": {
            "type": "string",
            "enum": [
              "project",
              "legal"
            ],
            "title": "Scope"
          },
          "backend": {
            "type": "string",
            "enum": [
              "none",
              "fixture",
              "pgvector"
            ],
            "title": "Backend"
          },
          "hits": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "type": "array",
            "title": "Hits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project_id",
          "scope",
          "backend",
          "hits"
        ],
        "title": "SearchResponse"
      },
      "Source": {
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Source Id"
          },
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Project Id"
          },
          "kind": {
            "$ref": "#/components/schemas/EvidenceType"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          },
          "target_field": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TargetField"
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_source_ids": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Parent Source Ids"
          },
          "locator": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
