        "additionalProperties": false,
        "type": "object",
        "required": [
          "project_id",
          "title"
        ],
        "title": "ProjectContext"
      },
      "QuestionRequest": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ProjectContext"
          },
