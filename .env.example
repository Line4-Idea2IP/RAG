# mock is deterministic and never calls a model. No silent fallback in live mode.
IDEA2IP_MODE=mock
IDEA2IP_RETRIEVAL=none
IDEA2IP_LLM_BASE_URL=http://localhost:8081/v1
IDEA2IP_LLM_MODEL=idea2ip-vl
IDEA2IP_LLM_TIMEOUT=90
IDEA2IP_LLM_MAX_TOKENS=2048
# Optional shared internal credential; generate locally, never commit .env.
IDEA2IP_SERVICE_TOKEN=
# Required only for pgvector. Use a dedicated Idea2IP DB, not the Spring DB.
IDEA2IP_DATABASE_URL=
IDEA2IP_INDEX_VERSION=idea2ip-v1
IDEA2IP_KURE_MODEL=nlpai-lab/KURE-v1
# Blank uses local sentence-transformers; otherwise existing /embed endpoint.
IDEA2IP_EMBEDDING_URL=
IDEA2IP_MIN_SIMILARITY=0.5
IDEA2IP_TOP_K=5
IDEA2IP_LEGAL_CATALOG=samples/legal_catalog.json
